{
  "manifest_version": 3,
  "name": "SpamShield for Gmail",
  "short_name": "SpamShield",
  "version": "1.0.1",
  "description": "Sorts your Gmail inbox into Important (OTPs, verification links), Genuine, Likely spam and Spam/Marketing with an on-device ML model.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "SpamShield for Gmail",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["model.js", "classifier.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
